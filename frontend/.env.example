# Copy this file to .env.local (gitignored) to point the frontend at a
# different backend than the default (http://localhost:8000).
#
# "localhost", NOT "127.0.0.1" (changed 2026-09-10, alongside the
# refresh-token cookie flow - see backend/auth_routes.py): the Vite dev
# server itself runs on "localhost" (see package.json/vite config), and
# a browser treats "localhost" and "127.0.0.1" as two DIFFERENT SITES
# for cookie purposes, even though they resolve to the same machine -
# the refresh-token cookie would silently never be sent back on
# /auth/refresh if this pointed at 127.0.0.1 while the app itself runs
# on localhost. `uvicorn api:app --reload` binds 127.0.0.1 by default,
# but that address still answers to the hostname "localhost" too - only
# the URL used to REACH it here needs to change, not how uvicorn binds.
VITE_API_BASE_URL=http://localhost:8000
