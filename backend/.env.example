# Copy this file to .env (gitignored) and fill in the real password -
# never commit the real .env or paste the real password into chat.
#
# Format: postgresql+psycopg2://<user>:<password>@<host>:<port>/<database>
# Values below (except password) are from Supabase's Session Pooler
# connection info (Project Settings -> Database -> Connect -> Session pooler):
DATABASE_URL=postgresql+psycopg2://postgres.afrptpbpjgmmsdulwcyx:YOUR_PASSWORD_HERE@aws-0-ap-south-1.pooler.supabase.com:5432/postgres

# Optional - base URL of the fitmodel service (see fitmodel/README.md),
# e.g. http://localhost:8123 for local dev or a deployed Lambda
# Function URL in production. Leave unset to keep
# GET /jobs/{id}/tailoring-report returning 503 "not available yet" -
# fitmodel isn't deployed as a live service yet.
FITMODEL_SERVICE_URL=

# "development" (the default if unset - fine for local work, no need
# to set this locally) or "production". Controls the refresh-token
# cookie's Secure/SameSite attributes (see auth_routes.py's module
# docstring for why) - MUST be set to "production" in the real deployed
# Lambda's environment variables, or the refresh-token flow silently
# breaks there (a plain-HTTP-safe cookie isn't valid over HTTPS+
# cross-origin, which is what production actually is).
ENVIRONMENT=development
