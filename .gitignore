# Python bytecode cache - regenerated automatically, not source code
__pycache__/
*.pyc

# Claude Code tooling state - not part of the project itself
.claude/

# Runtime state written by the app while it runs - not source code
matches_log.csv
seen_jobs.json

# Real secrets - only .env.example (with placeholder values) is committed
.env

# Lambda deploy BUILD OUTPUT only - the installed dependency tree and
# the zip built from it, both regenerated by deploy.ps1 on every run.
# build_zip.py itself is real source code and deliberately NOT matched
# by these patterns - a fresh clone needs it for deploy.ps1 to work.
backend/.deploy/package/
backend/.deploy/*.zip

# fitmodel/ - its own isolated venv (heavy: torch/sentence-transformers,
# regenerated via `pip install -r requirements.txt`) and trained/cached
# artifacts (regenerated via `python -m training.train` / on first
# suggest() call) - neither is source code.
fitmodel/venv/
fitmodel/models/*.joblib
fitmodel/models/*.npy
